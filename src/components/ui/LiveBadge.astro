---
interface Props {
  label?: string;
  class?: string;
}

const { label = 'LIVE', class: className = '' } = Astro.props;
---

<span
  class={`inline-flex items-center gap-2 rounded-full border border-live/40 bg-live/10 px-3 py-1 text-xs font-extrabold tracking-widest text-live ${className}`}
>
  <span class="relative flex h-2 w-2">
    <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-live opacity-75"></span>
    <span class="relative inline-flex h-2 w-2 rounded-full bg-live"></span>
  </span>
  {label}
</span>
