---
// A small broadcast-style scorebug label, used as an eyebrow above section headings.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span
  class={`inline-flex items-center gap-2 rounded-sm border-l-4 border-brand bg-night-alt px-3 py-1 font-display text-sm font-bold uppercase tracking-[0.2em] text-brand ${className}`}
>
  <slot />
</span>
