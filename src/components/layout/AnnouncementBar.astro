---
import { site } from '../../content/site';

const { text, href, dismissible } = site.announcement;
---

<div
  id="announcement-bar"
  class="relative z-40 flex items-center justify-center gap-3 bg-brand px-4 py-2 text-center text-sm font-bold text-night"
  data-dismissible={dismissible}
>
  <a href={href} class="underline-offset-2 hover:underline">
    🚨 {text}
  </a>
  {dismissible && (
    <button
      type="button"
      id="announcement-dismiss"
      aria-label="Dismiss announcement"
      class="absolute right-3 top-1/2 -translate-y-1/2 rounded p-1 text-night/70 hover:text-night focus-visible:outline-2 focus-visible:outline-night"
    >
      ✕
    </button>
  )}
</div>

<script>
  const KEY = 'mdl-announcement-dismissed';
  const bar = document.getElementById('announcement-bar');
  const dismissBtn = document.getElementById('announcement-dismiss');

  if (bar) {
    try {
      if (localStorage.getItem(KEY) === '1') {
        bar.style.display = 'none';
      }
    } catch {
      // ignore storage access errors (private browsing, etc.)
    }
  }

  dismissBtn?.addEventListener('click', () => {
    bar?.style.setProperty('display', 'none');
    try {
      localStorage.setItem(KEY, '1');
    } catch {
      // ignore
    }
  });
</script>
