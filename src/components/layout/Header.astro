---
import MobileNav from './MobileNav.tsx';

interface Props {
  variant?: 'default' | 'analytics';
}
const { variant = 'default' } = Astro.props;

const links = [
  { href: '/livestreaming', label: 'Livestreaming' },
  { href: '/analytics', label: 'Analytics' },
  { href: '/highlights', label: 'Highlights' },
  { href: '/about', label: 'About' },
  { href: '/partners', label: 'Partners' },
];

const logoSrc =
  variant === 'analytics' ? '/brand/matchday-analytics-logo.png' : '/brand/matchday-live-logo.png';
const logoHref = variant === 'analytics' ? '/analytics' : '/';
---

<header
  class="sticky top-0 z-30 border-b border-ink/10 bg-night/80 backdrop-blur-md"
  style="--header-h: 64px"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href={logoHref} class="flex items-center gap-2">
      <img src={logoSrc} alt="Matchday Live" class="h-10 w-auto" width="160" height="40" />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {links.map((link) => (
        <a
          href={link.href}
          class="font-display text-sm font-bold uppercase tracking-wide text-muted hover:text-brand"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/contact"
        class="hidden rounded-lg bg-brand px-4 py-2 font-display text-sm font-bold uppercase tracking-wide text-night hover:bg-brand-dark sm:inline-flex"
      >
        Request a Quote
      </a>
      <MobileNav client:load links={links} ctaHref="/contact" ctaLabel="Request a Quote" />
    </div>
  </div>
</header>
