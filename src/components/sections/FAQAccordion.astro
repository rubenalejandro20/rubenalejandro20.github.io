---
import SectionHeading from '../ui/SectionHeading.astro';

interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
  heading?: string;
}

const { faqs, heading = 'Frequently asked questions' } = Astro.props;
---

<section class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8">
  <SectionHeading heading={heading} />

  <div class="mt-10 divide-y divide-ink/10 border-y border-ink/10">
    {faqs.map((faq) => (
      <details class="group py-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-bold text-ink marker:content-none">
          {faq.question}
          <span class="flex-shrink-0 text-2xl text-brand transition-transform group-open:rotate-45">+</span>
        </summary>
        <p class="mt-3 text-muted">{faq.answer}</p>
      </details>
    ))}
  </div>
</section>
