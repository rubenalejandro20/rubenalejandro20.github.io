---
import SectionHeading from '../ui/SectionHeading.astro';

interface Step {
  step: number;
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  lead?: string;
  steps: Step[];
  tone?: 'brand' | 'lime';
  dark?: boolean;
}

const { eyebrow, heading, lead, steps, tone = 'brand', dark = false } = Astro.props;
const accent = tone === 'lime' ? 'text-lime border-lime/30' : 'text-brand border-brand/30';
---

<section class={dark ? 'bg-night-alt' : ''}>
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <SectionHeading align="center" tone={tone} eyebrow={eyebrow} heading={heading} lead={lead} />

    <ol class="mt-12 grid gap-8 sm:grid-cols-3">
      {steps.map((step) => (
        <li class={`rounded-2xl border bg-night p-6 ${accent}`}>
          <span class="font-display text-4xl font-extrabold">{step.step}</span>
          <h3 class="mt-3 font-display text-lg font-bold uppercase tracking-wide text-ink">{step.title}</h3>
          <p class="mt-2 text-sm text-muted">{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
