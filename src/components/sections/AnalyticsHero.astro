---
import Button from '../ui/Button.astro';

const trustItems = ['Tactical Analysis', 'Team Stats', 'Monthly Evolution Report', 'Monthly Strategic Sync'];
---

<section class="relative isolate overflow-hidden border-b border-ink/10 bg-night-alt">
  <div class="absolute inset-0 bg-stadium opacity-60"></div>
  <div class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <p class="font-display text-sm font-bold uppercase tracking-[0.3em] text-lime">Matchday Analytics</p>
    <h1 class="mt-4 max-w-3xl font-display text-5xl font-extrabold uppercase leading-[0.95] tracking-tight text-ink sm:text-6xl">
      Performance intelligence for competitive teams.
    </h1>
    <p class="mt-6 max-w-xl text-lg text-muted">
      Tactical clarity, measurable evolution, and purpose-driven development — built around your game model.
    </p>

    <div class="mt-10 flex flex-wrap gap-4">
      <Button href="/contact?type=analytics" class="!bg-lime !text-night hover:!bg-lime/80">
        Book a Discovery Call
      </Button>
      <Button href="/contact?type=analytics" variant="ghost">
        Request Proposal
      </Button>
    </div>

    <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-2 text-sm font-semibold text-muted">
      {trustItems.map((item) => (
        <li class="flex items-center gap-2">
          <span class="text-lime">✔</span>
          {item}
        </li>
      ))}
    </ul>
  </div>
</section>
