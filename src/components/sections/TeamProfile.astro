---
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import LowerThird from '../ui/LowerThird.astro';
import { team } from '../../content/team';

const member = team[0];
---

{member && (
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <SectionHeading tone="lime" eyebrow="Leadership & expertise" heading="Meet the analyst" />

    <div class="mt-12 grid gap-10 lg:grid-cols-[320px_1fr] lg:items-start">
      <div class="relative">
        <Image
          src={member.photo}
          alt={`${member.name}, ${member.role}`}
          width={320}
          height={360}
          class="aspect-[8/9] w-full rounded-2xl object-cover object-top"
        />
        <LowerThird name={member.name} role={member.role} class="absolute bottom-3 left-3 right-3" />
      </div>

      <div>
        <p class="text-lg text-muted">{member.bio}</p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {member.credentials.map((credential) => (
            <li class="flex items-start gap-2 rounded-xl border border-ink/10 bg-night-alt p-4 text-sm text-ink">
              <span class="text-lime">✔</span>
              {credential}
            </li>
          ))}
        </ul>

        {member.gallery && member.gallery.length > 0 && (
          <div class="mt-8 grid grid-cols-2 gap-4">
            {member.gallery.map((photo) => (
              <Image
                src={photo}
                alt={`${member.name} with the Atlético de Madrid team`}
                width={320}
                height={220}
                class="aspect-[4/3] w-full rounded-xl object-cover"
              />
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
)}
