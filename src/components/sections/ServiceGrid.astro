---
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import { services } from '../../content/services';

interface Props {
  limit?: number;
  showHeading?: boolean;
}
const { limit, showHeading = true } = Astro.props;
const items = limit ? services.slice(0, limit) : services;
---

<section class="bg-stadium">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    {showHeading && (
      <SectionHeading
        eyebrow="What we bring to the field"
        heading="Production built for matchday"
        lead="Every match gets the full broadcast treatment — not just a camera pointed at the pitch."
      />
    )}

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((service) => (
        <Card>
          <span class="text-3xl">{service.icon}</span>
          <h3 class="mt-4 font-display text-xl font-bold uppercase tracking-wide text-ink">
            {service.title}
          </h3>
          <p class="mt-2 text-sm text-muted">{service.description}</p>
        </Card>
      ))}
    </div>
  </div>
</section>
