---
import SectionHeading from '../ui/SectionHeading.astro';
import { partners } from '../../content/partners';

interface Props {
  showHeading?: boolean;
}
const { showHeading = true } = Astro.props;
---

{partners.length > 0 && (
  <section class="bg-ink/5">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      {showHeading && <SectionHeading align="center" eyebrow="Trusted by" heading="Our partners" />}
      <div class="mt-10 flex flex-wrap items-center justify-center gap-10">
        {partners.map((partner) => (
          <img src={partner.logo} alt={partner.name} loading="lazy" class="h-20 w-auto" />
        ))}
      </div>
    </div>
  </section>
)}
