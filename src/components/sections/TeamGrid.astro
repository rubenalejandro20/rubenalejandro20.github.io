---
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import { team } from '../../content/team';
---

{team.length > 0 && (
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <SectionHeading eyebrow="Who's behind it" heading="Team" />

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {team.map((member) => (
        <div class="overflow-hidden rounded-2xl border border-ink/10 bg-night-alt">
          <Image
            src={member.photo}
            alt={`${member.name}, ${member.role}`}
            width={400}
            height={300}
            class="aspect-[4/3] w-full object-cover object-top"
          />
          <div class="p-5">
            <h3 class="font-display text-lg font-bold uppercase tracking-wide text-ink">{member.name}</h3>
            <p class="text-sm font-semibold text-brand">{member.role}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
)}
