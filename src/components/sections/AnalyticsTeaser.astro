---
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { analyticsComponents } from '../../content/analytics-program';
---

<section class="border-y border-ink/10 bg-night-alt">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <SectionHeading
      align="center"
      tone="lime"
      eyebrow="Matchday Analytics"
      heading="Tactical clarity. Measurable evolution."
      lead="A monthly performance-analysis program for competitive clubs — built and led by a UEFA PRO licensed coach."
    />

    <ul class="mx-auto mt-10 grid max-w-3xl gap-4 sm:grid-cols-2">
      {analyticsComponents.map((component) => (
        <li class="flex items-center gap-3 rounded-xl border border-lime/20 bg-night px-4 py-3 text-left">
          <span class="text-2xl">{component.icon}</span>
          <span class="font-display text-sm font-bold uppercase tracking-wide text-ink">
            {component.title}
          </span>
        </li>
      ))}
    </ul>

    <div class="mt-10 text-center">
      <Button href="/analytics" class="!bg-lime !text-night hover:!bg-lime/80">
        Explore Matchday Analytics
      </Button>
    </div>
  </div>
</section>
