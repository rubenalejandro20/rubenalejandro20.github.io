---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import InquiryForm from '../components/forms/InquiryForm.tsx';
import { site } from '../content/site';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || site.web3forms.accessKeyFallback;
---

<BaseLayout
  title="Contact"
  description="Request a livestream production quote or book a Matchday Analytics discovery call. Reach Matchday Live by phone, email, or the form below."
  path="/contact"
>
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Get in touch"
      heading="Request a quote or book a call"
      lead="Tell us about your event or team and we'll follow up to confirm the details. No pricing is published here — we'll tailor a plan to your schedule and scope."
    />

    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_380px]">
      <InquiryForm client:load accessKey={accessKey} />

      <aside class="space-y-6">
        <div class="rounded-2xl border border-ink/10 bg-night-alt p-6">
          <h3 class="font-display text-sm font-bold uppercase tracking-wide text-ink">Email</h3>
          <a href={`mailto:${site.contact.email}`} class="mt-2 block text-brand hover:underline">
            {site.contact.email}
          </a>
        </div>

        <div class="rounded-2xl border border-ink/10 bg-night-alt p-6">
          <h3 class="font-display text-sm font-bold uppercase tracking-wide text-ink">Phone</h3>
          <ul class="mt-2 space-y-1">
            {site.contact.phones.map((phone) => (
              <li class="text-muted">
                <span class="text-muted/70">{phone.label}:</span>{' '}
                <a href={phone.href} class="text-brand hover:underline">
                  {phone.number}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-ink/10 bg-night-alt p-6">
          <h3 class="font-display text-sm font-bold uppercase tracking-wide text-ink">Follow along</h3>
          <div class="mt-2 flex flex-col gap-2">
            <a
              href={site.socials.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="text-brand hover:underline"
            >
              YouTube
            </a>
            <a
              href={site.socials.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="text-brand hover:underline"
            >
              Instagram
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
