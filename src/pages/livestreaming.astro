---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ServiceGrid from '../components/sections/ServiceGrid.astro';
import MatchdayWalkthrough from '../components/sections/MatchdayWalkthrough.astro';
import AudienceGrid from '../components/sections/AudienceGrid.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import CTABand from '../components/sections/CTABand.astro';
import LiveBadge from '../components/ui/LiveBadge.astro';
import Button from '../components/ui/Button.astro';
import { livestreamingFaqs } from '../content/faqs';
import { serviceJsonLd, faqJsonLd } from '../lib/seo';
---

<BaseLayout
  title="Livestreaming Services"
  description="Multi-camera HD livestreaming, real-time YouTube broadcasting, instant highlights, and full matchday production — for clubs, leagues, tournaments, and schools across Dallas–Fort Worth."
  path="/livestreaming"
  jsonLd={[
    serviceJsonLd({
      name: 'Sports Livestream Production',
      description:
        'Multi-camera HD livestreaming and full matchday production for soccer clubs, leagues, tournaments, and schools.',
    }),
    faqJsonLd(livestreamingFaqs),
  ]}
>
  <section class="border-b border-ink/10 bg-night-alt">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
      <LiveBadge class="mb-6" />
      <SectionHeading
        level="h1"
        heading="Broadcast-grade production for every matchday"
        lead="From a single camera on a tripod to a full multi-angle broadcast — Matchday Live brings the production value up to match the level of play."
      />
      <div class="mt-8">
        <Button href="/contact">Request a Quote</Button>
      </div>
    </div>
  </section>

  <ServiceGrid />
  <MatchdayWalkthrough />
  <AudienceGrid />
  <FAQAccordion faqs={livestreamingFaqs} heading="Livestreaming FAQ" />
  <CTABand
    heading="Let's put your next match on air."
    lead="Share your event details and we'll put together a coverage plan."
    primaryLabel="Request a Quote"
    primaryHref="/contact"
  />
</BaseLayout>
