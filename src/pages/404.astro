---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Offside! Page Not Found" description="This page doesn't exist." path="/404">
  <section class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center px-4 py-24 text-center sm:px-6 lg:px-8">
    <p class="font-display text-sm font-bold uppercase tracking-[0.3em] text-brand">Whistle blown</p>
    <h1 class="mt-4 font-display text-6xl font-extrabold uppercase tracking-tight text-ink sm:text-7xl">
      Offside!
    </h1>
    <p class="mt-4 max-w-md text-lg text-muted">
      This page isn't on the pitch. It may have moved, or the link might be offside.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <Button href="/">Back to Home</Button>
      <Button href="/contact" variant="ghost">
        Contact Us
      </Button>
    </div>
  </section>
</BaseLayout>
